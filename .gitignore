# Provide them through keystore.properties (local) or repository secrets (CI).
keystore.properties
*.jks
*.keystore

# NOTE: gradle/wrapper/gradle-wrapper.jar is intentionally NOT ignored -
# the wrapper jar must be committed so CI can bootstrap Gradle.
