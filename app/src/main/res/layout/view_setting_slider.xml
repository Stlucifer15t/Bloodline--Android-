<?xml version="1.0" encoding="utf-8"?>
<!--
    A settings row with a continuous value, e.g. volume.

    Same rule as the option row: the explanation gets the full width below the
    controls rather than sharing a squeezed column beside them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="vertical"
    android:paddingTop="@dimen/row_padding_vertical"
    android:paddingBottom="@dimen/row_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settingTitle"
            style="@style/Text.RowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/row_column_gap"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/settingValue"
            style="@style/Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxWidth="@dimen/row_value_max_width" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/settingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:max="100" />

    <TextView
        android:id="@+id/settingDetail"
        style="@style/Text.RowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2" />

</LinearLayout>
