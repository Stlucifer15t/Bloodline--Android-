<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings screen.

    The section panels are added at runtime (see SettingsActivity) because each
    row needs to know whether it can actually do anything yet; a static XML
    screen would happily show switches that control nothing.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@color/blood_800">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_gutter_top"
        android:paddingBottom="@dimen/screen_gutter_bottom">

        <TextView
            style="@style/Text.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <View
            android:layout_width="@dimen/header_rule_width"
            android:layout_height="@dimen/header_rule_height"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/rule_accent" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/settings_intro" />

        <!-- Filled at runtime with one panel per category. -->
        <LinearLayout
            android:id="@+id/settingsSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical" />

        <!--
            Heights are minimums, not fixed values. "RESET TO DEFAULTS" at a
            large device font scale outgrew the old 46dp box and was clipped.
        -->
        <Button
            android:id="@+id/resetButton"
            style="@style/Widget.Bloodlines.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_7"
            android:text="@string/settings_reset" />

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Bloodlines.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_back" />

    </LinearLayout>

</ScrollView>
