<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcherScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@color/blood_800">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/screen_gutter_top"
        android:paddingBottom="@dimen/screen_gutter_bottom">

        <!-- ============================ Branding ============================ -->
        <ImageView
            android:layout_width="@dimen/brand_emblem_size"
            android:layout_height="@dimen/brand_emblem_size"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/brand_emblem_description"
            android:src="@drawable/ic_emblem" />

        <!--
            The wordmark is the widest single line in the app. match_parent plus
            uniform auto-shrink means it scales itself down on a narrow phone
            instead of running off the edge; "BLOODLINES" at 30sp with wide
            letter spacing does not fit a 320dp screen.
        -->
        <TextView
            style="@style/Text.Brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:autoSizeMaxTextSize="@dimen/text_brand"
            android:autoSizeMinTextSize="@dimen/text_brand_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_horizontal"
            android:text="@string/brand_title" />

        <View
            android:layout_width="@dimen/brand_rule_width"
            android:layout_height="@dimen/divider_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/divider_blood" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_3"
            android:contentDescription="@null"
            android:src="@drawable/ornament_lozenge" />

        <TextView
            style="@style/Text.BrandSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center_horizontal"
            android:text="@string/brand_subtitle" />

        <TextView
            style="@style/Text.Stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_horizontal"
            android:text="@string/brand_stage" />

        <!-- ======================= Game installation ======================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/card_surface_accent"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_card_install" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_icon_gap"
                    android:layout_weight="1"
                    android:text="@string/section_game_installation" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_3"
                android:background="@color/hairline_strong" />

            <include
                android:id="@+id/installStatus"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/hairline" />

            <include
                android:id="@+id/installExpected"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/installSearchPath"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/installNote"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/install_detail_not_found" />

            <TextView
                android:id="@+id/installVerified"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textColor="@color/ash_faint"
                android:visibility="gone"
                tools:text="Verified 11/11/26, 14:02 · 12,480 entries examined"
                tools:visibility="visible" />

            <!--
                Real import progress: a genuine stage name plus the number of
                entries actually examined. There is no percentage, because the
                scanner cannot know the total before it has listed everything.
            -->
            <LinearLayout
                android:id="@+id/importProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/importProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/importProgressText"
                    style="@style/Text.RowDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    tools:text="Scanning folders…\n12,480 entries examined · 34 folders" />

            </LinearLayout>

            <Button
                android:id="@+id/importButton"
                style="@style/Widget.Bloodlines.OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/import_game_files" />

        </LinearLayout>

        <!-- ====================== Compatibility runtime ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_card_runtime" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_icon_gap"
                    android:layout_weight="1"
                    android:text="@string/section_runtime" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_3"
                android:background="@color/hairline_strong" />

            <include
                android:id="@+id/runtimeOverall"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <include
                android:id="@+id/runtimeNative"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeWine"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeCpu"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeContainer"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeGraphics"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeAudio"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/runtimeStorage"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--
                The runtime is downloaded rather than bundled, so there has to
                be a way to fetch it that the launch gate cannot close. The
                Launch button is disabled until the game files exist; this one
                is not, because the runtime has nothing to do with them.
            -->
            <Button
                android:id="@+id/runtimeInstallButton"
                style="@style/Widget.Bloodlines.OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/runtime_install_action"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Feedback for the download, next to the button that started it. -->
            <LinearLayout
                android:id="@+id/runtimeInstallProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/runtimeInstallProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/runtimeInstallProgressText"
                    style="@style/Text.RowDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    tools:text="Wine 11.3\n42% of this package · 1 of 2" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/hairline" />

            <!-- Measured on the device, not assumed. Tap for the full report. -->
            <include
                android:id="@+id/runtimeCapability"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ============================== Display =========================== -->
        <!--
            Every value in this panel is either measured from the device or
            computed from a stored choice. The old version of this card showed a
            hard-coded "1280 × 720", which looked like a setting and was
            nothing of the kind.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_section_display" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_icon_gap"
                    android:layout_weight="1"
                    android:text="@string/section_display" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_3"
                android:background="@color/hairline_strong" />

            <include
                android:id="@+id/displayPanel"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <include
                android:id="@+id/displayGameResolution"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/displayRenderResolution"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/displayNote"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/display_panel_note" />

        </LinearLayout>

        <!-- ============================== Audio ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_section_audio" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_icon_gap"
                    android:layout_weight="1"
                    android:text="@string/section_audio" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_3"
                android:background="@color/hairline_strong" />

            <include
                android:id="@+id/audioVolume"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <include
                android:id="@+id/audioBackend"
                layout="@layout/view_config_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/audio_panel_note" />

        </LinearLayout>

        <!-- ============================ Diagnostics ======================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_section_diagnostics" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_icon_gap"
                    android:layout_weight="1"
                    android:text="@string/section_diagnostics" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_3"
                android:background="@color/hairline_strong" />

            <include
                android:id="@+id/diagnosticsStatus"
                layout="@layout/view_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <TextView
                android:id="@+id/diagnosticsDetail"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/diagnostics_none_detail" />

            <!--
                Four buttons in one row left ~64dp each on a 360dp phone, which
                is below what "GENERATE" needs at 11sp bold — and the style's
                singleLine then cut the label off rather than wrapping it.
                Two rows of two, with wrap_content heights, cannot clip.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnosticsGenerateButton"
                    style="@style/Widget.Bloodlines.CompactButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_generate" />

                <Button
                    android:id="@+id/diagnosticsSaveButton"
                    style="@style/Widget.Bloodlines.CompactButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_save" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnosticsShareButton"
                    style="@style/Widget.Bloodlines.CompactButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_share" />

                <Button
                    android:id="@+id/diagnosticsDeleteButton"
                    style="@style/Widget.Bloodlines.CompactButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:text="@string/diagnostics_delete" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================== Launch =========================== -->
        <Button
            android:id="@+id/launchButton"
            style="@style/Widget.Bloodlines.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:enabled="false"
            android:text="@string/launch_game" />

        <TextView
            android:id="@+id/launchHint"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="@string/launch_locked_no_runtime" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Widget.Bloodlines.OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/open_settings" />

        <!-- ============================== Footer =========================== -->
        <TextView
            android:id="@+id/footerVersion"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            tools:text="Milestone 2 · runtime foundation build 0.2.0" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="@string/footer_disclaimer"
            android:textColor="@color/ash_faint" />

    </LinearLayout>

</ScrollView>
