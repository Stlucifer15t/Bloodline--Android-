<?xml version="1.0" encoding="utf-8"?>
<!--
    A panel, not a floating card: a small radius and a hairline seam keep a
    stack of these from reading as six rounded boxes pasted onto the screen.
    No <padding> here — the layout owns its padding, otherwise every card gets
    an invisible extra 2dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ink_850" />
    <stroke
        android:width="1dp"
        android:color="@color/hairline" />
    <corners android:radius="@dimen/card_radius" />
</shape>
