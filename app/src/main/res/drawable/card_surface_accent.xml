<?xml version="1.0" encoding="utf-8"?>
<!--
    The one panel that carries the accent: the game installation card, which is
    the only thing standing between the user and a working launch.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ink_850" />
    <stroke
        android:width="1dp"
        android:color="@color/blood_800" />
    <corners android:radius="@dimen/card_radius" />
</shape>
