<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_700" />
            <stroke
                android:width="1dp"
                android:color="@color/ink_600" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/blood_800"
                android:startColor="@color/blood_600"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/blood_700"
                android:startColor="@color/blood_500"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4CD42A33" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
