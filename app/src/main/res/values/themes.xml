<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        A hand built dark theme. The parent is only used for the AppCompat
        widget infrastructure; every visible attribute is overridden here so
        the launcher does not inherit stock Material styling.
    -->
    <style name="Theme.Bloodlines" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blood_600</item>
        <item name="colorPrimaryDark">@color/blood_700</item>
        <item name="colorAccent">@color/blood_500</item>
        <item name="colorControlNormal">@color/ash</item>
        <item name="colorControlActivated">@color/blood_400</item>
        <item name="colorControlHighlight">#33B3121C</item>

        <item name="android:windowBackground">@drawable/bg_launcher</item>
        <item name="android:colorBackground">@color/ink_900</item>
        <item name="android:statusBarColor">@color/ink_900</item>
        <item name="android:navigationBarColor">@color/ink_900</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <item name="android:textColorPrimary">@color/bone</item>
        <item name="android:textColorSecondary">@color/bone_dim</item>
        <item name="android:textColorTertiary">@color/ash</item>
        <item name="android:textColorHint">@color/ash_dim</item>
    </style>

    <!--
        Base text style.

        It exists because the child styles below use dot notation
        (Text.Brand, Text.RowTitle, ...): in Android a dot means "inherit from
        the style named before the dot", so `Text` itself has to be defined.
    -->
    <style name="Text">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/bone</item>
    </style>

    <!-- Branding -->
    <style name="Text.Brand">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:letterSpacing">0.32</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#CC5C0A10</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">14</item>
    </style>

    <style name="Text.BrandSub">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/bone_dim</item>
        <item name="android:letterSpacing">0.34</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Stage">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/ash_dim</item>
        <item name="android:letterSpacing">0.4</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Card heading -->
    <style name="Text.SectionTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/blood_400</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Rows inside cards -->
    <style name="Text.RowTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.RowDetail">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/ash</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Value">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bone_dim</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ash_dim</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.StatusChip">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:textColor">@color/ash</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>


    <!--
        Widget styles use dot notation, so every parent in the name has to be
        defined or the resource linker refuses the whole file.
    -->
    <style name="Widget" />

    <style name="Widget.Bloodlines" />

    <!-- Compact button used in rows of four, e.g. the diagnostics card. -->
    <style name="Widget.Bloodlines.SmallButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
