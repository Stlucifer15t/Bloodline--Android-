    <!-- Reasons a row is disabled. Shown verbatim so nothing is faked. -->
    <string name="setting_needs_runtime">Needs the compatibility runtime. The value is remembered and will be applied as soon as the runtime exists.</string>
    <string name="setting_needs_input_layer">Needs the touch input layer, which has not been built yet.</string>
    <string name="setting_unsupported">Not offered: nothing in the stack exposes this control.</string>

    <!-- Display -->
    <string name="setting_display_detected">Detected display</string>
    <string name="setting_display_detected_detail">Measured from this device right now: the panel size Android reports, and its refresh rate. Nothing here is estimated.</string>
    <string name="setting_display_resolution">Display resolution</string>
    <string name="setting_display_resolution_detail">The size the game surface is presented at — what the Windows desktop inside the container is told the screen is. Native follows the real display.</string>
    <string name="setting_custom_resolution">Custom resolution</string>
    <string name="setting_custom_resolution_detail">Used when Display resolution is Custom. Clamped to %1$d–%2$d wide and %3$d–%4$d tall, and reduced further if this screen cannot show it.</string>
    <string name="setting_render_scale">Internal render resolution</string>
    <string name="setting_render_scale_detail">How much of the display resolution the game actually renders, before the GPU scales it back up. The cheapest setting on a Mali-G52, and the one that buys the most frame rate.</string>
    <string name="setting_custom_scale">Custom scaling</string>
    <string name="setting_custom_scale_detail">Used when Internal render resolution is Custom. Accepted between %1$d%% and %2$d%%.</string>
    <string name="setting_render_plan">Resulting render size</string>
    <string name="setting_render_plan_detail">What the two settings above add up to on this display: the presented size, then the size actually rendered. Computed from the measured display, not assumed.</string>
    <string name="setting_aspect_mode">Aspect ratio</string>
    <string name="setting_aspect_mode_detail">How a frame whose shape differs from the display is fitted to it. Preserve keeps the game\'s own shape; Fit shows all of it; Stretch fills the screen and distorts.</string>
    <string name="setting_letterbox">Letterbox / pillarbox</string>
    <string name="setting_letterbox_detail">Fill the area a preserved frame cannot cover with black bars, instead of cropping the frame to fill the screen.</string>
    <string name="setting_fullscreen_scaling">Fullscreen scaling</string>
    <string name="setting_fullscreen_scaling_detail">Scale a frame smaller than the display up to fill it, instead of showing it pixel for pixel and centred.</string>
    <string name="setting_reset_graphics">Reset graphics settings</string>
    <string name="setting_reset_graphics_detail">Forgets the display resolution, scaling, fitting and renderer choices in this build and restores their defaults. Unlike the rows above, this works today.</string>
    <string name="settings_graphics_reset_done">Graphics settings restored</string>
    <string name="setting_orientation_note">The launcher follows your device\'s rotation. The game runs landscape regardless: that is a requirement of the game, not a preference, so no setting here can change it.</string>
    <string name="setting_immersive">Immersive mode</string>
    <string name="setting_immersive_detail">Hide the system bars while the app is in front. Applied immediately.</string>
    <string name="setting_keep_awake">Keep screen awake</string>
    <string name="setting_keep_awake_detail">Stops the screen from dimming while the app is in front.</string>
    <string name="setting_ui_scale">Interface scale</string>
    <string name="setting_ui_scale_detail">Scales the launcher\'s own text and spacing.</string>
    <string name="setting_brightness">Screen brightness</string>
    <string name="setting_brightness_detail">Applied to this app\'s window only: Android has not allowed apps to change the system brightness since Android 6.</string>

    <!-- Performance -->
    <string name="setting_fps_limit">Frame rate limit</string>
    <string name="setting_fps_limit_detail">Caps how often the game surface may present a frame. A lower cap means less heat and battery drain on the Helio G85.</string>
    <string name="setting_vsync">VSync</string>
    <string name="setting_vsync_detail">Only present frames in step with the display refresh.</string>
    <string name="setting_frame_pacing">Frame pacing</string>
    <string name="setting_frame_pacing_detail">Even out the interval between frames instead of presenting them as fast as possible.</string>
    <string name="setting_fps_overlay">Frame rate overlay</string>
    <string name="setting_fps_overlay_detail">Shows the frame rate measured from real display frames, so you can verify the limit above is actually doing something.</string>
    <string name="setting_performance_preset">Performance preset</string>
    <string name="setting_performance_preset_detail">A coarse bundle of tuning choices the runtime applies together.</string>

    <!-- Graphics -->
    <string name="setting_renderer">Renderer</string>
    <string name="setting_renderer_detail">The graphics backend used once the translation layer exists. The safe path stays the default until alternatives are proven on this device.</string>
    <string name="renderer_wined3d">WineD3D + VirGL (safe)</string>
    <string name="renderer_panvk">DXVK + PanVK (experimental)</string>
    <string name="setting_renderer_fallback_note">WineD3D + VirGL works on Mali without a Vulkan driver. DXVK + PanVK is recorded as experimental and is never selected automatically: it only becomes the default after it has been tested on this device.</string>

    <!-- Audio -->
    <string name="setting_master_volume">Master volume</string>
    <string name="setting_master_volume_detail">Sets the Android music stream volume: the volume the game will play at. Verified against the device, not just stored.</string>
    <string name="setting_audio_backend">Audio backend</string>
    <string name="setting_audio_backend_detail">Which Android audio path the runtime\'s audio bridge should use.</string>
    <string name="setting_audio_channels">Music / effects / dialogue</string>
    <string name="setting_audio_channels_detail">Separate channel volumes live inside the game\'s own mixer. Only the runtime can reach them, so they are not offered as sliders that would do nothing.</string>

