    <string name="settings_title">Settings</string>
    <string name="settings_intro">Every switch on this screen has a real effect. Anything that cannot work yet is shown greyed out with the reason, rather than pretending to do something.</string>
    <string name="settings_reset">Reset To Defaults</string>
    <string name="settings_back">Back To Launcher</string>
