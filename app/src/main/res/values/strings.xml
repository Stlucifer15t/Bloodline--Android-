    <string name="setting_install_status">Installation status</string>
    <string name="setting_install_status_detail">What the last verified scan concluded. The launcher reuses this instead of walking the game folder on every start.</string>
    <string name="setting_rescan">Re-scan for game files</string>
    <string name="setting_rescan_detail">Forces a fresh scan instead of reusing the cached result.</string>
    <string name="setting_clear_cache">Clear cached scan data</string>
    <string name="setting_clear_cache_detail">Forgets what the last scan proved, so the next start scans again from scratch. Your game files are never touched.</string>
