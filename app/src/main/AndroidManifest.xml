<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Only what the app genuinely uses. Game files are read through the
        Storage Access Framework and app-specific storage (getExternalFilesDir
        / filesDir), neither of which needs a runtime permission.

        IMPORTANT (future native runtime): the Android 10+ W^X policy forbids
        executing binaries out of the writable app data directory. The native
        runtime therefore has to ship its executables as shared libraries
        (lib*.so) in the APK so that the package installer extracts them into
        the executable, read-only nativeLibraryDir. That is why
        android:extractNativeLibs is pinned to "true" here. Wine itself is
        unaffected: exec() from app data is still permitted for a targetSdk 28
        app, which is precisely why this one is pinned to 28 rather than 36.
    -->
    <!--
        Required by the runtime acquisition path, and by nothing else: Wine and
        the WoW64 layer are downloaded from their upstream releases on first run
        instead of being bundled.

        This was missing for the whole of the work that built the downloader.
        No unit test could have caught it — every one hands
        RuntimePackageManager either a fake or a server on localhost, and CI
        does not install the APK — so the first real download failed inside
        URL.openConnection() with "Permission denied". The bug was a missing
        declaration rather than wrong code, which is the one shape a unit test
        cannot see, so CI now checks the manifest (see android.yml).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Read-only, and only so a 227 MB download can say "no connection"
        before it starts rather than surfacing a socket error the user cannot
        act on. No runtime prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Needed to *tune* the native port, and for nothing else.

        The port keeps its settings under the shared storage the user chose
        (`Download/<folder>/overlay/port_settings.txt`). That is not reachable
        through the Storage Access Framework as a plain file, and the port does
        not export a content provider, so writing there needs the storage
        permission.

        Deliberately the **legacy** permission rather than
        `MANAGE_EXTERNAL_STORAGE`: this app targets API 28, so the legacy
        storage model still applies and the all-files permission would be both
        ignored by the platform and a larger ask than the job needs.

        Reading the game and this app's own runtime never relies on it — the
        scanner reads the game in place through SAF, and the runtime writes only
        under app storage.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />


    <application
        android:name=".BloodlinesApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Bloodlines"
        tools:targetApi="31">

        <!--
            No screenOrientation is declared, on purpose.

            Both activities used to be pinned to "portrait", which meant a
            single global preference decided the orientation of every screen and
            could contradict the one rule that is not a preference: the game is
            a landscape Windows title and has to run landscape. Orientation is
            now driven per phase by OrientationController — the launcher follows
            the device, and gameplay forces landscape and restores the launcher
            afterwards.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Bloodlines"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the user share or save a diagnostics report. Only the reports
            folder is reachable through it; see res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Bloodlines" />
    </application>

</manifest>
