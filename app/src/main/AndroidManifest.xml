<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No permissions are requested at this stage.

        The launcher only reads app-specific storage (getExternalFilesDir /
        filesDir), which requires no runtime permission and works under
        Android 11+ scoped storage. Permissions such as POST_NOTIFICATIONS or
        storage access via the Storage Access Framework will be added in the
        milestone that introduces the runtime and the game-file importer.

        IMPORTANT (future native runtime): the Android 10+ W^X policy forbids
        executing binaries out of the writable app data directory. The native
        runtime therefore has to ship its executables as shared libraries
        (lib*.so) in the APK so that the package installer extracts them into
        the executable, read-only nativeLibraryDir. That is why
        android:extractNativeLibs is pinned to "true" here.
    -->
    <application
        android:name=".BloodlinesApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Bloodlines"
        tools:targetApi="31">

        <!--
            No screenOrientation is declared, on purpose.

            Both activities used to be pinned to "portrait", which meant a
            single global preference decided the orientation of every screen and
            could contradict the one rule that is not a preference: the game is
            a landscape Windows title and has to run landscape. Orientation is
            now driven per phase by OrientationController — the launcher follows
            the device, and gameplay forces landscape and restores the launcher
            afterwards.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Bloodlines"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the user share or save a diagnostics report. Only the reports
            folder is reachable through it; see res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.Bloodlines" />
    </application>

</manifest>
